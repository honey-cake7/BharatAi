{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DefectEventTelemetry",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string" },
    "component_type": { "type": "string" },
    "anomaly_score": { "type": "number" },
    "threshold": { "type": "number" },
    "defect_characteristics": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "bounding_box": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 4,
          "maxItems": 4
        },
        "affected_area_pct": { "type": "number" }
      },
      "required": ["category", "bounding_box", "affected_area_pct"]
    }
  },
  "required": ["timestamp", "component_type", "anomaly_score", "threshold", "defect_characteristics"]
}
